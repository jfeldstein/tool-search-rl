# Copy this file to .env and fill in your values

# OpenPipe API Key (required for production)
# Get your key from https://app.openpipe.ai
OPENPIPE_API_KEY=your-api-key-here

# The model slug from your RLVR training
# This should match the model_slug used in TrainingConfig
OPENPIPE_MODEL_SLUG=tool-selector-llama-8b-v1

# Environment (development/production)
ENVIRONMENT=development
